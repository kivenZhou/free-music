{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YinZhan",
  "version": "0.1.1",
  "identifier": "com.zzy.yinzhan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "音栈",
        "width": 1180,
        "height": 760,
        "minWidth": 380,
        "minHeight": 120
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost https://asset.localhost; img-src 'self' https: http: data: blob: asset:; media-src 'self' https: http: blob: asset: http://asset.localhost https://asset.localhost; connect-src 'self' https: http: ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$CACHE/**",
          "$LOCALDATA/zzy/yinzhan/**",
          "$APPDATA/zzy/yinzhan/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEOENERkE5OUUzMzNCNDEKUldSQk96T2VxZCtNclo1a3pVWGMwZld0NTVWMThhSGFnMmxFU0NIKzg0UUl3SjI2MWEvRVQ2ODEK",
      "endpoints": [
        "https://ghfast.top/https://github.com/kivenZhou/free-music/releases/latest/download/latest.json",
        "https://github.com/kivenZhou/free-music/releases/latest/download/latest.json"
      ]
    }
  }
}
