{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "音栈",
  "version": "0.1.0",
  "identifier": "com.zzy.yinzhan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "音栈",
        "width": 1180,
        "height": 760,
        "minWidth": 380,
        "minHeight": 120
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost https://asset.localhost; img-src 'self' https: http: data: blob: asset:; media-src 'self' https: http: blob: asset: http://asset.localhost https://asset.localhost; connect-src 'self' https: http: ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$CACHE/**",
          "$LOCALDATA/zzy/yinzhan/**",
          "$APPDATA/zzy/yinzhan/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
